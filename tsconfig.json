{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "svelte",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "conformance/**/*",
    "experiments/**/*"
  ],
  "exclude": [
    "experiments/agent-consumption/harness"
  ]
}
