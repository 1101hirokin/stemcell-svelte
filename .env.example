# 値は .env.local に置く(git に載せない)。このファイルは名前だけの見本。

# playground の dev server の待ち受け先。未設定なら localhost のまま。
# true で全インターフェース、IP を書けばそのアドレスだけで待つ。
# 外(tailscale 等)から触るときに要る。
PLAYGROUND_HOST=

# 待ち受けポート。指定すると strictPort になり、空いていなければ別番号へ
# 逃げずに落ちる(外から転送する先が黙ってずれるのを防ぐ)。未設定なら vite の既定。
PLAYGROUND_PORT=

# dev server が受けるホスト名。既定の localhost 以外(tailscale 等)から触るときに要る。
# カンマ区切りで複数書ける。URL で書いてもホスト名だけ取り出す。
PLAYGROUND_ALLOWED_HOSTS=
